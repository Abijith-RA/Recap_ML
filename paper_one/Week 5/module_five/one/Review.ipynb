   "source": [
    "Vector_one = [10, 20, 30]\n",
    "Vector_two = [2, 5, 8]\n",
    "\n",
    "def vectors_add(v1, v2):\n",
    "    \n",
    "    result = []\n",
    "    \n",
    "    for i in range(len(v1)):\n",
    "        \n",
    "        value = v1[i] + v2[i]\n",
    "        \n",
    "        result.append(value)\n",
    "        \n",
    "    return result\n",
    "\n",
    "vectors_add(Vector_one, Vector_two)    "
   ]
  }
 ],
